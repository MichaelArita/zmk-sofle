#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        Browser_Tabs: Browser_Tabs {
            compatible = "zmk,behavior-tap-dance";
            label = "BROWSER_TABS";
            #binding-cells = <0>;
            bindings = <&kp LC(W)>, <&mt (LC(LS(T))) LC(T)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Settings {
            bindings = <&mo 4>;
            key-positions = <56 60>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC                  &kp N1     &kp N2        &kp N3          &kp N4     &kp N5       &kp UP_ARROW     &kp N6     &kp N7           &kp N8                       &kp N9                           &kp N0                       &kp BACKSPACE
&auto_shift TILDE GRAVE  &kp Q      &kp W         &kp E           &kp R      &kp T        &kp DOWN_ARROW   &kp Y      &kp U            &kp I                        &kp O                            &kp P                        &kp BSLH
&kp LEFT_CONTROL         &kp A      &kp S         &kp D           &kp F      &kp G        &kp LEFT_ARROW   &kp H      &kp J            &kp K                        &kp L                            &auto_shift COLON SEMICOLON  &auto_shift DOUBLE_QUOTES SINGLE_QUOTE
&kp LEFT_ALT             &kp Z      &kp X         &kp C           &kp V      &kp B        &kp RIGHT_ARROW  &kp N      &kp M            &auto_shift LESS_THAN COMMA  &auto_shift GREATER_THAN PERIOD  &auto_shift QUESTION SLASH   &kp RIGHT_ALT
&kp C_MUTE               &kp LCTRL  &kp LEFT_GUI  &kp LEFT_SHIFT  &lt 3 TAB  &kp SPACE    &kp ENTER        &kp SPACE  &lt 2 BACKSPACE  &kp RIGHT_SHIFT              &kp RGUI                         &mt ESCAPE RIGHT_CONTROL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "Base";
        };

        Gaming {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &mmv MOVE_UP     &kp N6   &kp N7           &kp N8           &kp N9    &kp N0    &tog 1
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &mmv MOVE_DOWN   &kp Y    &kp U            &kp I            &kp O     &kp P     &mt LC(BACKSPACE) BACKSPACE
&kp LCTRL   &kp A      &kp S         &kp D         &kp F   &kp G        &mmv MOVE_LEFT   &kp H    &kp J            &kp K            &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &mmv MOVE_RIGHT  &kp N    &kp M            &kp COMMA        &kp DOT   &kp FSLH  &kp RCTRL
&kp C_MUTE  &kp GRAVE  &kp LEFT_WIN  &kp LEFT_ALT  &mo 3   &kp SPACE    &mkp LCLK        &kp RET  &lt 2 BACKSPACE  &kp RIGHT_SHIFT  &kp RGUI  &kp ESC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "Gaming Layer";
        };

        NumberSymbol {
            bindings = <
&kp F13  &kp F14          &kp F15                  &kp F16   &kp F17         &kp F18            &trans  &kp F19           &kp F20            &kp F21       &kp F22               &kp F23                &kp F24
&trans   &kp N1           &kp N2                   &kp N3    &kp N4          &kp N5             &trans  &kp N6            &kp N7             &kp N8        &kp N9                &kp N0                 &trans
&trans   &kp EXCLAMATION  &kp AT_SIGN              &kp HASH  &kp DOLLAR      &kp PERCENT        &trans  &kp CARET         &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans   &kp EQUAL        &auto_shift UNDER MINUS  &kp PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI      &kp COLON             &kp BACKSLASH          &trans
&trans   &trans           &trans                   &trans    &trans          &trans             &trans  &trans            &trans             &trans        &kp COMMA             &kp PERIOD
            >;

            display-name = "Number and Symbol Layer";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Utility {
            bindings = <
&kp F1  &kp F2     &kp F3         &kp F4           &kp F5       &kp F6                   &trans  &kp F7           &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&trans  &trans     &Browser_Tabs  &kp LC(LS(TAB))  &kp LC(TAB)  &mt (LC(LS(N))) LC(N)    &trans  &kp PAGE_UP      &kp HOME        &kp UP_ARROW    &kp END          &trans   &kp DEL
&trans  &kp LC(A)  &kp LCTRL      &trans           &kp LALT     &kp CAPS                 &trans  &kp PAGE_DOWN    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &kp LC(Z)  &kp LC(X)      &kp LC(C)        &kp LC(V)    &trans                   &trans  &kp PRINTSCREEN  &trans          &trans          &trans           &trans   &trans
&trans  &trans     &trans         &trans           &trans       &trans                   &trans  &trans           &trans          &trans          &trans           &trans
            >;

            label = "Utility Layer";
        };

        Settings {
            bindings = <
&out OUT_TOG  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &rgb_ug RGB_TOG  &caps_word  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans  &trans
&trans        &bt BT_CLR_ALL  &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &trans          &trans  &trans           &trans      &trans           &trans           &trans  &trans
&trans        &trans          &trans        &trans        &trans        &tog 1          &trans  &trans           &trans      &trans           &trans           &trans  &trans
&trans        &soft_off       &trans        &trans        &sys_reset    &bootloader     &trans  &bootloader      &sys_reset  &trans           &trans           &trans  &trans
&trans        &trans          &trans        &trans        &trans        &trans          &trans  &trans           &trans      &trans           &trans           &trans
            >;

            label = "Settings Layer";
        };
    };
};
